@page "/produtos"

<h3>Produtos</h3>

<div class="row">
    <div class="col-md-4">
        <Cartao Titulo="Cadastro de Produto">
            <FormProduto OnProdutoAdicionado="AdicionarProduto" />
        </Cartao>
    </div>

    <div class="col-md-8">
        @if (produtos.Count == 0)
        {
            <p class="text-muted">Nenhum produto cadastrado.</p>
        }
        else
        {
            <TabelaProdutos Produtos="produtos" />
        }
    </div>
</div>

@code {
    private List<Produto> produtos = new();

    private void AdicionarProduto(Produto produto)
    {
        produtos.Add(produto);
    }
}
